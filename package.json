{
  "name": "clem",
  "version": "0.3.0-preview.11",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types --import ./vendor/kinetra/scripts/_register.mjs server/index.ts",
    "build": "node scripts/build-kinetra.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node scripts/build-kinetra.mjs && node --experimental-strip-types --import ./vendor/kinetra/scripts/_register.mjs --test tests/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "deploy": "node scripts/sync-env.mjs && node scripts/prepare-deploy.mjs && npx vercel deploy .deploy/site --prod --yes --scope m4labs",
    "build:vercel": "node scripts/build-api.mjs --root && npm run build",
    "desktop:build": "npm run build && tsc -p desktop/tsconfig.json && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist/main.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.cjs --win --dir",
    "desktop:installer": "npm run desktop:build && electron-builder --config electron-builder.cjs --win && node scripts/publish-installer.mjs",
    "ledger": "node --experimental-strip-types scripts/answer-ledger.mjs",
    "test:desktop": "node scripts/build-kinetra.mjs && node --experimental-strip-types --test tests/desktop/*.test.ts",
    "desktop:smoke": "node scripts/smoke-desktop.mjs",
    "installer:publish": "node scripts/publish-installer.mjs",
    "db:admin": "npx wrangler d1 execute clem-workspaces --remote --file cloudflare/admin-schema.sql",
    "deploy:accounts": "npx wrangler deploy --config cloudflare/account.wrangler.jsonc",
    "verify:ui": "node scripts/verify/settings.mjs && node scripts/verify/notices.mjs",
    "installer:release": "node scripts/publish-installer.mjs --site",
    "emails": "node scripts/build-emails.mjs",
    "emails:art": "node scripts/build-email-art.mjs",
    "emails:apply": "node scripts/apply-email-templates.mjs",
    "verify:all": "node scripts/verify/run-all.mjs",
    "verify:local": "node scripts/verify/local-power.mjs",
    "film:demo": "node scripts/film/capture.mjs && node scripts/film/render.mjs",
    "film:live-setup": "node scripts/film/capture.mjs --live-setup",
    "film:live": "node scripts/film/capture.mjs --live && node scripts/film/render.mjs --live",
    "ads": "node scripts/ads/build.mjs",
    "db:remove-telegram": "npx wrangler d1 execute clem-workspaces --remote --file cloudflare/remove-telegram.sql",
    "db:email": "npx wrangler d1 execute clem-workspaces --remote --file cloudflare/email-schema.sql",
    "emails:announce": "node scripts/announce-release.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/sandbox": "3.3.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.0",
    "electron-updater": "6.8.10",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "idb-keyval": "^6.2.2",
    "ignore": "7.0.5",
    "jose": "^6.2.12",
    "katex": "^0.16.47",
    "libheif-js": "1.23.2",
    "nodemailer": "10.0.9",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "pyodide": "^314.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@openai/codex": "0.160.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "7.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "gifenc": "^1.0.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "Clem: a calm, local-first Windows workspace for projects, study and documents, powered by the AI plan you already have.",
  "license": "MIT",
  "author": "Mohamed Mowafy",
  "homepage": "https://clem.m4labs.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mowfxy/clem.git"
  },
  "bugs": {
    "url": "https://github.com/mowfxy/clem/issues"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
