{
  "name": "mowr",
  "version": "0.2.0-preview.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --experimental-strip-types --import ./vendor/kinetra/scripts/_register.mjs server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --import ./vendor/kinetra/scripts/_register.mjs --test tests/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "deploy": "node scripts/sync-env.mjs && node scripts/prepare-deploy.mjs && npx vercel deploy .deploy/site --prod --yes --scope mowr1",
    "build:vercel": "node scripts/build-api.mjs --root && npm run build",
    "desktop:build": "npm run build && tsc -p desktop/tsconfig.json && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist/main.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --config electron-builder.cjs --win --dir",
    "desktop:installer": "npm run desktop:build && electron-builder --config electron-builder.cjs --win",
    "test:desktop": "node --experimental-strip-types --test tests/desktop/*.test.ts",
    "desktop:smoke": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "2.116.0",
    "@vercel/sandbox": "3.3.0",
    "docx": "^9.7.1",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "idb-keyval": "^6.2.2",
    "ignore": "7.0.5",
    "jose": "^6.2.12",
    "nodemailer": "10.0.9",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@openai/codex": "0.155.1",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "7.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "Mowr local desktop workspace and marketing website",
  "overrides": {
    "image-size": "2.0.4"
  }
}
