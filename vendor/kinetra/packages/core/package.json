{
  "name": "@kinetra/core",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --import ../../scripts/_register.mjs --test test/**/*.test.ts",
    "test:watch": "node --experimental-strip-types --import ../../scripts/_register.mjs --test --watch test/**/*.test.ts"
  },
  "dependencies": {
    "pdf-parse": "1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  }
}
