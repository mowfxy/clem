{
  "version": 1,
  "title": "Truss: method of joints",
  "caption": "Equilateral panels (4 m), P = 20 kN at B; T = tension, C = compression",
  "canvas": { "width": 900, "height": 430, "world": { "xMin": -1.2, "xMax": 15.6, "yMin": -2.4, "yMax": 5.2 } },
  "vars": {
    "s": "4 m", "h": "s*sin(60 deg)", "P": "20 kN",
    "RA": "P/2", "RC": "P/2",
    "FAD": "-RA/sin(60 deg)", "FAB": "-FAD*cos(60 deg)",
    "FDB": "-FAD", "FDE": "FAD*cos(60 deg) - FDB*cos(60 deg)",
    "FBE": "(P - FDB*sin(60 deg))/sin(60 deg)", "FBC": "FAB - FDB*cos(120 deg) - FBE*cos(60 deg)"
  },
  "scales": { "force": { "per": "10 kN" } },
  "elements": [
    { "id": "tr", "type": "truss", "joints": [{ "x": 0, "y": 0 }, { "x": "s", "y": 0 }, { "x": "2*s", "y": 0 }, { "x": "s/2", "y": "h" }, { "x": "1.5*s", "y": "h" }],
      "members": [[0, 1], [1, 2], [0, 3], [3, 1], [1, 4], [4, 2], [3, 4]] },
    { "id": "sA", "type": "pinSupport", "scale": 1.3, "at": "tr.joint(0)", "mayTouch": ["tr"] },
    { "id": "sC", "type": "rollerSupport", "scale": 1.3, "at": "tr.joint(2)", "mayTouch": ["tr"] },
    { "id": "P", "type": "pointLoad", "tip": "tr.joint(1)", "magnitude": "P", "label": "P = 20 kN", "mayTouch": ["tr"] },
    { "id": "nA", "type": "text", "text": "A", "at": { "ref": "tr.joint(0)", "dx": -0.45, "dy": 0.3 } },
    { "id": "nB", "type": "text", "text": "B", "at": { "ref": "tr.joint(1)", "dx": -0.45, "dy": -0.35 } },
    { "id": "nC", "type": "text", "text": "C", "at": { "ref": "tr.joint(2)", "dx": 0.45, "dy": 0.3 } },
    { "id": "nD", "type": "text", "text": "D", "at": { "ref": "tr.joint(3)", "dx": -0.4, "dy": 0.3 } },
    { "id": "nE", "type": "text", "text": "E", "at": { "ref": "tr.joint(4)", "dx": 0.4, "dy": 0.3 } },
    { "id": "mAB", "type": "text", "text": "5.77 kN (T)", "size": 11, "at": { "ref": "tr.member(0)", "dx": 0, "dy": 0.32 } },
    { "id": "mBC", "type": "text", "text": "5.77 kN (T)", "size": 11, "at": { "ref": "tr.member(1)", "dx": 0, "dy": 0.32 } },
    { "id": "mAD", "type": "text", "text": "11.5 kN (C)", "size": 11, "at": { "ref": "tr.member(2)", "dx": -1.05, "dy": 0.1 } },
    { "id": "mDB", "type": "text", "text": "11.5 kN (T)", "size": 11, "at": { "ref": "tr.member(3)", "dx": -0.9, "dy": -0.1 } },
    { "id": "mBE", "type": "text", "text": "11.5 kN (T)", "size": 11, "at": { "ref": "tr.member(4)", "dx": 0.9, "dy": -0.1 } },
    { "id": "mEC", "type": "text", "text": "11.5 kN (C)", "size": 11, "at": { "ref": "tr.member(5)", "dx": 1.05, "dy": 0.1 } },
    { "id": "mDE", "type": "text", "text": "11.5 kN (C)", "size": 11, "at": { "ref": "tr.member(6)", "dx": 0, "dy": 0.3 } },
    { "id": "RAa", "type": "pointLoad", "tip": "sA.base", "angle": 90, "magnitude": "RA", "color": "normal", "label": "R_A" },
    { "id": "RCa", "type": "pointLoad", "tip": "sC.base", "angle": 90, "magnitude": "RC", "color": "normal", "label": "R_C" },
    { "id": "jB", "type": "point", "at": { "x": 12.6, "y": 2.0 } },
    { "id": "jBt", "type": "text", "text": "Free body of joint B", "at": { "x": 12.6, "y": 4.4 } },
    { "id": "fBA", "type": "force", "from": "jB", "angle": 180, "magnitude": "FAB", "label": "F_{AB}", "mayTouch": ["jB", "fBD", "fBE", "fBC", "fP"] },
    { "id": "fBD", "type": "force", "from": "jB", "angle": 120, "magnitude": "FDB", "label": "F_{BD}", "mayTouch": ["jB", "fBA", "fBE", "fBC", "fP"] },
    { "id": "fBE", "type": "force", "from": "jB", "angle": 60, "magnitude": "FBE", "label": "F_{BE}", "mayTouch": ["jB", "fBA", "fBD", "fBC", "fP"] },
    { "id": "fBC", "type": "force", "from": "jB", "angle": 0, "magnitude": "FBC", "label": "F_{BC}", "mayTouch": ["jB", "fBA", "fBD", "fBE", "fP"] },
    { "id": "fP", "type": "force", "from": "jB", "angle": -90, "magnitude": "P", "label": "P", "mayTouch": ["jB", "fBA", "fBD", "fBE", "fBC"] }
  ],
  "checks": [
    { "id": "global_sumF", "type": "vectorSum", "vectors": ["P", "RAa", "RCa"], "tol": "1e-9 N" },
    { "id": "global_sumM_A", "type": "momentSum", "about": "tr.joint(0)", "vectors": ["P", "RAa", "RCa"], "tol": "1e-9 N*m" },
    { "id": "joint_B_equilibrium", "type": "vectorSum", "vectors": ["fBA", "fBD", "fBE", "fBC", "fP"], "tol": "1e-9 N" },
    { "id": "statically_determinate", "type": "equal", "left": "tr.members + 3", "right": "2*tr.joints" },
    { "id": "symmetry_BC_AB", "type": "equal", "left": "FBC", "right": "FAB", "tol": "1e-9 N" },
    { "id": "symmetry_DE_AD", "type": "equal", "left": "FDE", "right": "FAD", "tol": "1e-9 N" }
  ]
}
