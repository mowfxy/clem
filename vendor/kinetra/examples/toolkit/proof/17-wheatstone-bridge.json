{
  "version": 1,
  "title": "Unbalanced Wheatstone bridge: solved branch currents",
  "caption": "Nodal analysis with C as reference; galvanometer resistance R_g = 50 Ω",
  "canvas": { "width": 760, "height": 560, "world": { "xMin": -2.3, "xMax": 6.9, "yMin": -3.6, "yMax": 3.0 } },
  "vars": {
    "Vs": "10 V", "R1": "100 ohm", "R2": "200 ohm", "R3": "150 ohm", "R4": "250 ohm", "Rg": "50 ohm",
    "Gb": "1/R1 + 1/R2 + 1/Rg", "Gd": "1/R3 + 1/R4 + 1/Rg",
    "det": "Gb*Gd - 1/Rg^2",
    "VB": "(Vs/R1*Gd + Vs/R3/Rg)/det", "VD": "(Gb*Vs/R3 + Vs/R1/Rg)/det",
    "I1": "(Vs - VB)/R1", "I2": "VB/R2", "I3": "(Vs - VD)/R3", "I4": "VD/R4", "Ig": "(VB - VD)/Rg", "Is": "I1 + I3"
  },
  "elements": [
    { "id": "A", "type": "point", "at": { "x": 0, "y": 0 } },
    { "id": "B", "type": "point", "at": { "x": 2.2, "y": 1.7 } },
    { "id": "C", "type": "point", "at": { "x": 4.4, "y": 0 } },
    { "id": "D", "type": "point", "at": { "x": 2.2, "y": -1.7 } },
    { "id": "Ra", "type": "resistor", "at": { "x": 1.1, "y": 0.85 }, "rotation": "atan2(1.7, 2.2)", "scale": 1.7, "label": { "text": "R_1 = 100 Ω", "position": "above-left" } },
    { "id": "Rb", "type": "resistor", "at": { "x": 3.3, "y": 0.85 }, "rotation": "atan2(-1.7, 2.2)", "scale": 1.7, "label": { "text": "R_2 = 200 Ω", "position": "above-right" } },
    { "id": "Rc", "type": "resistor", "at": { "x": 1.1, "y": -0.85 }, "rotation": "atan2(-1.7, 2.2)", "scale": 1.7, "label": "R_3 = 150 Ω" },
    { "id": "Rd", "type": "resistor", "at": { "x": 3.3, "y": -0.85 }, "rotation": "atan2(1.7, 2.2)", "scale": 1.7, "label": "R_4 = 250 Ω" },
    { "id": "Gm", "type": "galvanometer", "at": { "x": 2.2, "y": 0 }, "rotation": 90, "scale": 2.0 },
    { "id": "Bat", "type": "battery", "at": { "x": 2.2, "y": -2.9 }, "scale": 1.8, "label": "V_s = 10 V" },
    { "id": "wa1", "type": "wire", "points": ["A", "Ra.pin0"] },
    { "id": "wa3", "type": "wire", "points": ["A", "Rc.pin0"] },
    { "id": "wb1", "type": "wire", "points": ["Ra.pin1", "B"] },
    { "id": "wb2", "type": "wire", "points": ["B", "Rb.pin0"] },
    { "id": "wbg", "type": "wire", "points": ["B", "Gm.pin1"] },
    { "id": "wc2", "type": "wire", "points": ["Rb.pin1", "C"] },
    { "id": "wc4", "type": "wire", "points": ["Rd.pin1", "C"] },
    { "id": "wd3", "type": "wire", "points": ["Rc.pin1", "D"] },
    { "id": "wd4", "type": "wire", "points": ["D", "Rd.pin0"] },
    { "id": "wdg", "type": "wire", "points": ["Gm.pin0", "D"] },
    { "id": "ws1", "type": "wire", "points": ["Bat.pin0", { "x": -1.2, "y": -2.9 }, { "x": -1.2, "y": 0 }, "A"] },
    { "id": "ws2", "type": "wire", "points": ["Bat.pin1", { "x": 5.6, "y": -2.9 }, { "x": 5.6, "y": 0 }, "C"] },
    { "id": "jA", "type": "junction", "at": "A", "wires": ["wa1", "wa3", "ws1"] },
    { "id": "jB", "type": "junction", "at": "B", "wires": ["wb1", "wb2", "wbg"] },
    { "id": "jC", "type": "junction", "at": "C", "wires": ["wc2", "wc4", "ws2"] },
    { "id": "jD", "type": "junction", "at": "D", "wires": ["wd3", "wd4", "wdg"] },
    { "id": "nA", "type": "text", "text": "A", "at": { "x": -0.35, "y": 0.3 } },
    { "id": "nB", "type": "text", "text": "B", "at": { "x": 2.2, "y": 2.05 } },
    { "id": "nC", "type": "text", "text": "C", "at": { "x": 4.75, "y": 0.3 } },
    { "id": "nD", "type": "text", "text": "D", "at": { "x": 2.2, "y": -2.05 } },
    { "id": "iS", "type": "currentArrow", "from": { "x": -1.2, "y": -2.9 }, "to": { "x": -1.2, "y": 0 }, "label": "I_s = 58.4 mA" },
    { "id": "iG", "type": "currentArrow", "from": "Gm.pin0", "to": "D", "t": 0.5, "label": "I_g" },
    { "id": "tbl", "type": "table", "at": { "x": 6.15, "y": 2.2 }, "size": 11, "rows": [["branch", "I (mA)"], ["R₁", "34.65"], ["R₂", "32.67"], ["R₃", "23.76"], ["R₄", "25.74"], ["G", "1.98"]] }
  ],
  "checks": [
    { "id": "kcl_B", "type": "kcl", "node": "B", "currents": [{ "value": "I1", "direction": "in" }, { "value": "I2", "direction": "out" }, { "value": "Ig", "direction": "out" }] },
    { "id": "kcl_D", "type": "kcl", "node": "D", "currents": [{ "value": "I3", "direction": "in" }, { "value": "Ig", "direction": "in" }, { "value": "I4", "direction": "out" }] },
    { "id": "kcl_C", "type": "kcl", "node": "C", "currents": [{ "value": "I2", "direction": "in" }, { "value": "I4", "direction": "in" }, { "value": "Is", "direction": "out" }] },
    { "id": "kvl_ABD", "type": "equal", "left": "I1*R1 + Ig*Rg", "right": "I3*R3", "tol": "1e-12 V" },
    { "id": "kvl_source_ABC", "type": "equal", "left": "I1*R1 + I2*R2", "right": "Vs", "tol": "1e-12 V" },
    { "id": "bridge_unbalanced", "type": "greater", "left": "Ig", "right": "0 A" }
  ]
}
