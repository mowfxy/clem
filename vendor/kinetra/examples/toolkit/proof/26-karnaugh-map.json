{
  "version": 1,
  "title": "Karnaugh map: F(A, B, C, D) = Σm(0, 2, 5, 7, 8, 10, 13, 15)",
  "caption": "Rows AB and columns CD in Gray-code order; groups give F = B'D' + BD (corners wrap around)",
  "canvas": { "width": 640, "height": 600, "world": { "xMin": -2.0, "xMax": 5.0, "yMin": -5.5, "yMax": 1.6 } },
  "vars": { "c": "1 m" },
  "elements": [
    { "id": "frame", "type": "rect", "at": { "x": 2, "y": -2 }, "w": 4, "h": 4, "stroke": "ink" },
    { "id": "v1", "type": "segment", "from": { "x": 1, "y": 0 }, "to": { "x": 1, "y": -4 }, "width": 1, "mayTouch": ["frame"] },
    { "id": "v2", "type": "segment", "from": { "x": 2, "y": 0 }, "to": { "x": 2, "y": -4 }, "width": 1, "mayTouch": ["frame"] },
    { "id": "v3", "type": "segment", "from": { "x": 3, "y": 0 }, "to": { "x": 3, "y": -4 }, "width": 1, "mayTouch": ["frame"] },
    { "id": "h1", "type": "segment", "from": { "x": 0, "y": -1 }, "to": { "x": 4, "y": -1 }, "width": 1, "mayTouch": ["frame", "v1", "v2", "v3"] },
    { "id": "h2", "type": "segment", "from": { "x": 0, "y": -2 }, "to": { "x": 4, "y": -2 }, "width": 1, "mayTouch": ["frame", "v1", "v2", "v3"] },
    { "id": "h3", "type": "segment", "from": { "x": 0, "y": -3 }, "to": { "x": 4, "y": -3 }, "width": 1, "mayTouch": ["frame", "v1", "v2", "v3"] },
    { "id": "cd0", "type": "text", "text": "00", "at": { "x": 0.5, "y": 0.3 } },
    { "id": "cd1", "type": "text", "text": "01", "at": { "x": 1.5, "y": 0.3 } },
    { "id": "cd2", "type": "text", "text": "11", "at": { "x": 2.5, "y": 0.3 } },
    { "id": "cd3", "type": "text", "text": "10", "at": { "x": 3.5, "y": 0.3 } },
    { "id": "ab0", "type": "text", "text": "00", "at": { "x": -0.35, "y": -0.5 } },
    { "id": "ab1", "type": "text", "text": "01", "at": { "x": -0.35, "y": -1.5 } },
    { "id": "ab2", "type": "text", "text": "11", "at": { "x": -0.35, "y": -2.5 } },
    { "id": "ab3", "type": "text", "text": "10", "at": { "x": -0.35, "y": -3.5 } },
    { "id": "hdr", "type": "text", "text": "AB \\ CD", "at": { "x": -0.6, "y": 0.75 } },
    { "id": "m0", "type": "text", "text": "1", "size": 13, "at": { "x": 0.5, "y": -0.5 } },
    { "id": "m1", "type": "text", "text": "0", "size": 13, "at": { "x": 1.5, "y": -0.5 } },
    { "id": "m3", "type": "text", "text": "0", "size": 13, "at": { "x": 2.5, "y": -0.5 } },
    { "id": "m2", "type": "text", "text": "1", "size": 13, "at": { "x": 3.5, "y": -0.5 } },
    { "id": "m4", "type": "text", "text": "0", "size": 13, "at": { "x": 0.5, "y": -1.5 } },
    { "id": "m5", "type": "text", "text": "1", "size": 13, "at": { "x": 1.5, "y": -1.5 } },
    { "id": "m7", "type": "text", "text": "1", "size": 13, "at": { "x": 2.5, "y": -1.5 } },
    { "id": "m6", "type": "text", "text": "0", "size": 13, "at": { "x": 3.5, "y": -1.5 } },
    { "id": "m12", "type": "text", "text": "0", "size": 13, "at": { "x": 0.5, "y": -2.5 } },
    { "id": "m13", "type": "text", "text": "1", "size": 13, "at": { "x": 1.5, "y": -2.5 } },
    { "id": "m15", "type": "text", "text": "1", "size": 13, "at": { "x": 2.5, "y": -2.5 } },
    { "id": "m14", "type": "text", "text": "0", "size": 13, "at": { "x": 3.5, "y": -2.5 } },
    { "id": "m8", "type": "text", "text": "1", "size": 13, "at": { "x": 0.5, "y": -3.5 } },
    { "id": "m9", "type": "text", "text": "0", "size": 13, "at": { "x": 1.5, "y": -3.5 } },
    { "id": "m11", "type": "text", "text": "0", "size": 13, "at": { "x": 2.5, "y": -3.5 } },
    { "id": "m10", "type": "text", "text": "1", "size": 13, "at": { "x": 3.5, "y": -3.5 } },
    { "id": "gBD", "type": "roundedBox", "at": { "x": 2, "y": -2 }, "w": 1.7, "h": 1.7, "r": 0.3, "fill": "none", "stroke": "rayAlt", "mayTouch": ["v2", "h2"] },
    { "id": "gTL", "type": "roundedBox", "at": { "x": 0.42, "y": -0.42 }, "w": 0.72, "h": 0.72, "r": 0.2, "fill": "none", "stroke": "force" },
    { "id": "gTR", "type": "roundedBox", "at": { "x": 3.58, "y": -0.42 }, "w": 0.72, "h": 0.72, "r": 0.2, "fill": "none", "stroke": "force" },
    { "id": "gBL", "type": "roundedBox", "at": { "x": 0.42, "y": -3.58 }, "w": 0.72, "h": 0.72, "r": 0.2, "fill": "none", "stroke": "force" },
    { "id": "gBR", "type": "roundedBox", "at": { "x": 3.58, "y": -3.58 }, "w": 0.72, "h": 0.72, "r": 0.2, "fill": "none", "stroke": "force" },
    { "id": "lg", "type": "legend", "at": { "x": 2, "y": -4.55 }, "entries": [{ "text": "BD (m5, m7, m13, m15)", "kind": "box", "color": "rayAlt", "fill": "white" }, { "text": "B'D' (m0, m2, m8, m10)", "kind": "box", "color": "force", "fill": "white" }] }
  ],
  "checks": [
    { "id": "map_matches_minterms", "type": "table", "fn": "1 - min(1, abs(m - 0)*abs(m - 2)*abs(m - 5)*abs(m - 7)*abs(m - 8)*abs(m - 10)*abs(m - 13)*abs(m - 15))", "var": "m",
      "rows": [[0, 1], [1, 0], [2, 1], [3, 0], [4, 0], [5, 1], [6, 0], [7, 1], [8, 1], [9, 0], [10, 1], [11, 0], [12, 0], [13, 1], [14, 0], [15, 1]] },
    { "id": "simplified_equals_canonical", "type": "table", "fn": "(1 - mod(floor(m/4), 2))*(1 - mod(m, 2)) + mod(floor(m/4), 2)*mod(m, 2)", "var": "m",
      "rows": [[0, 1], [1, 0], [2, 1], [3, 0], [4, 0], [5, 1], [6, 0], [7, 1], [8, 1], [9, 0], [10, 1], [11, 0], [12, 0], [13, 1], [14, 0], [15, 1]] },
    { "id": "group_centred_on_quad", "type": "equal", "left": "gBD.x", "right": "2*c", "tol": "1e-12 m" }
  ]
}
