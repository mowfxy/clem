{
  "version": 1,
  "title": "Hydrogen energy levels and emission lines",
  "caption": "Eₙ = −13.6 eV/n²; drawn to scale (vertical: 0.45 m per eV); λ = hc/ΔE",
  "canvas": { "width": 720, "height": 620, "world": { "xMin": -2.6, "xMax": 7.6, "yMin": -0.9, "yMax": 7.6 } },
  "vars": { "Ry": "13.6 eV", "k": "0.45 m/eV", "y0": "15 eV",
            "E1": "-Ry/1^2", "E2": "-Ry/2^2", "E3": "-Ry/3^2", "E4": "-Ry/4^2",
            "h": "6.62607015e-34 J*s", "c": "2.99792458e8 m/s",
            "lamHa": "h*c/(E3 - E2)", "lamHb": "h*c/(E4 - E2)", "lamLa": "h*c/(E2 - E1)" },
  "elements": [
    { "id": "L1", "type": "segment", "from": { "x": 0, "y": "k*(E1 + y0)" }, "to": { "x": 6.4, "y": "k*(E1 + y0)" }, "width": 2 },
    { "id": "L2", "type": "segment", "from": { "x": 0, "y": "k*(E2 + y0)" }, "to": { "x": 6.4, "y": "k*(E2 + y0)" }, "width": 2 },
    { "id": "L3", "type": "segment", "from": { "x": 0, "y": "k*(E3 + y0)" }, "to": { "x": 6.4, "y": "k*(E3 + y0)" }, "width": 2 },
    { "id": "L4", "type": "segment", "from": { "x": 0, "y": "k*(E4 + y0)" }, "to": { "x": 6.4, "y": "k*(E4 + y0)" }, "width": 2 },
    { "id": "Linf", "type": "segment", "from": { "x": 0, "y": "k*y0" }, "to": { "x": 6.4, "y": "k*y0" }, "width": 1, "dashed": true },
    { "id": "t1", "type": "text", "text": "n = 1   −13.6 eV", "size": 11, "at": { "ref": "L1.start", "dx": -1.3 } },
    { "id": "t2", "type": "text", "text": "n = 2   −3.40 eV", "size": 11, "at": { "ref": "L2.start", "dx": -1.3 } },
    { "id": "t3", "type": "text", "text": "n = 3   −1.51 eV", "size": 11, "at": { "ref": "L3.start", "dx": -1.3 } },
    { "id": "t4", "type": "text", "text": "n = 4   −0.85 eV", "size": 11, "at": { "ref": "L4.start", "dx": -1.3 } },
    { "id": "tinf", "type": "text", "text": "n = ∞   0 eV", "size": 11, "at": { "ref": "Linf.start", "dx": -1.3 } },
    { "id": "Lya", "type": "arrow", "from": { "ref": "L2.start", "dx": 0.9 }, "to": { "ref": "L1.start", "dx": 0.9 }, "color": "acceleration", "mayTouch": ["L2", "L1"], "label": "Lyman α 122 nm" },
    { "id": "Ha", "type": "arrow", "from": { "ref": "L3.start", "dx": 3.6 }, "to": { "ref": "L2.start", "dx": 3.6 }, "color": "ray", "mayTouch": ["L3", "L2"], "label": "Hα 656 nm" },
    { "id": "Hb", "type": "arrow", "from": { "ref": "L4.start", "dx": 4.9 }, "to": { "ref": "L2.start", "dx": 4.9 }, "color": "rayAlt", "mayTouch": ["L4", "L3", "L2"], "label": "Hβ 486 nm" }
  ],
  "checks": [
    { "id": "Ha_arrow_to_scale", "type": "equal", "left": "Ha.length", "right": "k*(E3 - E2)", "tol": "1e-12 m" },
    { "id": "Hb_arrow_to_scale", "type": "equal", "left": "Hb.length", "right": "k*(E4 - E2)", "tol": "1e-12 m" },
    { "id": "Lya_arrow_to_scale", "type": "equal", "left": "Lya.length", "right": "k*(E2 - E1)", "tol": "1e-12 m" },
    { "id": "H_alpha_wavelength", "type": "equal", "left": "lamHa", "right": "656.1 nm", "tol": "0.5 nm" },
    { "id": "H_beta_wavelength", "type": "equal", "left": "lamHb", "right": "486.0 nm", "tol": "0.5 nm" },
    { "id": "Rydberg_formula", "type": "equal", "left": "1/lamHa", "right": "Ry/(h*c)*(1/2^2 - 1/3^2)", "tol": "1e-6 /m" },
    { "id": "emission_points_down", "type": "equal", "left": "Ha.angle", "right": "-90 deg", "tol": "1e-12 deg" }
  ]
}
