{
  "name": "clem-accounts",
  "main": "account-worker.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clem-workspaces",
      "database_id": "51b5667b-5712-4f80-9559-efcf62940dfb"
    }
  ],
  // The per-IP and per-person request limits (lib/http.js limitFast): counted by Cloudflare, not in D1. Each namespace_id
  // is this account's own number for a counter; the limits match the D1 fallback's.
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
    { "name": "RL_ADMIN_IP", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "LEMON_TEST_MODE": "true",
    "ADMIN_REQUIRE_MFA": "true",
    "SUPABASE_URL": "https://npdkvkikudvjrgnesuhc.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_iuAX6xFMvThhHYTWkT3fMw_CtkABHLu",
    // The Clem bot's username (without @), from BotFather. Empty: Telegram is off. TELEGRAM_BOT_TOKEN and
    // TELEGRAM_WEBHOOK_SECRET are secrets (wrangler secret put), never written here.
    "TELEGRAM_BOT_USERNAME": "M4ClemBot"
  },
  "preview_urls": false
}
