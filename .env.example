# Clem configuration. Never commit .env.local.
# Empty values are intentionally awaiting your credentials.

# Production app
APP_URL="https://clem.m4labs.xyz"
SESSION_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""
CRON_SECRET=""

# Supabase authentication and private file storage
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_ACCESS_TOKEN=""
GOOGLE_AUTH_CLIENT_ID=""
GOOGLE_AUTH_CLIENT_SECRET=""

# Cloudflare workspace database
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_DATABASE_ID="your-d1-database-id"
CLOUDFLARE_DATABASE_URL="https://clem-database.your-subdomain.workers.dev"
CLOUDFLARE_DATABASE_SECRET=""
CLOUDFLARE_API_TOKEN=""

# Legacy web-only API adapters. The desktop never reads these keys.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_CONTEXT="32000"
OPENAI_SPECIALTIES=""
XAI_API_KEY=""
XAI_MODEL=""
XAI_CONTEXT="32000"
XAI_SPECIALTIES=""

# Google Drive OAuth (separate from Google sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Zoho SMTP. Use your regional server and an app password.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="support@m4labs.xyz"
SMTP_PASSWORD=""
SMTP_FROM="Clem <support@m4labs.xyz>"

# Optional deployment automation
VERCEL_TOKEN=""
VERCEL_ORG_ID="team_your-vercel-team-id"
VERCEL_PROJECT_ID="prj_your-vercel-project-id"

FILE_GATE_SECRET=

# Clean Codex/Grok runtime snapshot. Never snapshot user credentials.
SUBSCRIPTION_RUNTIME_SNAPSHOT_ID=""

# Desktop public configuration (included in the main-process build, never secrets)
CLEM_ACCOUNT_SERVICE="https://clem-accounts.your-subdomain.workers.dev"
# Optional development executable override; production bundles official Codex.
CLEM_CODEX_EXECUTABLE=""
# Signing credentials belong only in the secure build environment.
CLEM_REQUIRE_SIGNING="false"
# Local experiments only: lets `npm run desktop:build` finish without the sign-in config (a worktree has none).
# CLEM_ALLOW_NO_SIGNIN="1"

# Configure these as Cloudflare Worker secrets/variables, not renderer variables.
# LEMON_API_KEY, LEMON_WEBHOOK_SECRET, LEMON_STORE_ID, LEMON_VARIANT_ID
# LEMON_TEST_MODE=true until real test-mode checkout and webhook verification pass.
# Telegram (docs/DESKTOP.md "Deploying Telegram"): Worker secrets TELEGRAM_BOT_TOKEN (from BotFather) and
# TELEGRAM_WEBHOOK_SECRET (random, 32+ characters); the bot username is TELEGRAM_BOT_USERNAME in account.wrangler.jsonc.
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_BOT_USERNAME="YourClemBot"
# Clem's VPS worker (docs/GUC-VPS-ENGINE.md "Background worker"). Not read by the desktop build: the desktop writes
# these on the server at install (docker-compose.yml / clem-worker.service and the worker's .env, mode 600).
# DATABASE_URL=""            # Postgres (Docker); left out, the worker uses PGlite under CLEM_DATA
# CLEM_DATA=""               # the worker's state: database, sealed secrets, workspace snapshot
# CLEM_FILES=""              # ~/clem/<owner>/files, the same folder the desktop's VpsStore reads over SFTP
# CLEM_KEY_FILE=""           # the 32-byte AES-256-GCM key (base64) for the sealed secrets
# CLEM_PORT="7717"           # the worker's endpoint, on 127.0.0.1 only (reached through the SSH tunnel)
# CLEM_BIND="127.0.0.1"      # the worker's listen address; the Docker image sets 0.0.0.0 inside its own network
# POSTGRES_PASSWORD=""       # Docker's Postgres, made at install
